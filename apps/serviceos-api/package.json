{
  "name": "@serviceos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "prisma db push --skip-generate && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:dev": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/serviceos-suite.test.ts test/service-phase2.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@lifeos/shared": "*",
    "@serviceos/shared": "*",
    "@prisma/client": "^6.5.0",
    "fastify": "^5.2.1",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
